<template>
  <div class="page">
    <div class="header">
      <div class="back" @click="goBack">
        <image class="back-icon" src="/common/images/ic_back.png"></image>
      </div>
      <text class="header-title">阅读</text>
      <text class="page-num">{{pageInfo}}</text>
    </div>

    <div class="song">
      <text class="song-title">{{songTitle}}</text>
      <text class="song-artist">{{songArtist}}</text>
    </div>

    <div class="content" if="{{lines.length > 0}}">
      <block for="{{pageLines}}">
        <div class="line-row" @click="onLine($item)">
          <div class="time-col">
            <text class="line-time" if="{{$item.first}}">{{$item.timeText}}</text>
          </div>
          <text class="line-text {{$item.active ? 'line-text-active' : ''}}">{{$item.text}}</text>
        </div>
      </block>
    </div>

    <div class="empty" if="{{lines.length === 0}}">
      <text class="empty-title">没有可显示的内容</text>
      <text class="empty-desc">{{reason}}</text>
      <div class="chip" @click="goBack"><text class="chip-text">返回词本</text></div>
    </div>

    <div class="footer">
      <div class="nav-btn {{page <= 0 ? 'nav-btn-disabled' : ''}}" @click="prevPage"><text class="nav-text">上一页</text></div>
      <div class="follow {{follow ? 'follow-on' : ''}}" @click="toggleFollow"><text class="follow-text">{{follow ? '跟随中' : '跟随播放'}}</text></div>
      <div class="nav-btn {{page >= pageCount - 1 ? 'nav-btn-disabled' : ''}}" @click="nextPage"><text class="nav-text">下一页</text></div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import player from '../../common/scripts/player-state.js'
import library from '../../common/scripts/library.js'
import store from '../../common/scripts/store.js'
import lrc from '../../common/scripts/lrc.js'
import debug from '../../common/scripts/debug.js'

export default {
  protected: {
    key: '',
    title: '',
    artist: ''
  },
  data: {
    songTitle: '',
    songArtist: '',
    lines: [],
    rows: [],
    lineRowStart: [],
    pageLines: [],
    page: 0,
    pageCount: 1,
    pageInfo: '1/1',
    pageSize: 8,
    follow: true,
    isCurrent: false,
    currentIndex: -1,
    reason: '回到歌词本选择一首，或在手机端同步歌词'
  },
  onInit() {
    debug.mark('page:reader', 'onInit key=' + (this.key || ''))
    try {
      this.follow = player.snapshot().follow
      this.unsubscribe = player.subscribe((reason, view) => {
        this.onPlayer(view)
      })
    } catch (e) {
      debug.error('page:reader', 'subscribe', e)
    }
    // 不依赖 player.init() 完成：词库文件是独立读取的，
    // 以前 init 一旦不返回，这一页就永远是空白，表现为「点了没反应」。
    this.load()
    try {
      player.init().catch(function () {})
    } catch (e) {}
  },
  onShow() {
    this.follow = player.snapshot().follow
    if (this.lines.length) {
      this.onPlayer(player.snapshot())
    }
  },
  onDestroy() {
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
  },
  async load() {
    try {
      await this.loadInner()
    } catch (e) {
      debug.error('page:reader', 'load', e)
    }
  },
  async loadInner() {
    const view = player.snapshot()
    let text = ''
    let key = this.key
    let title = this.title
    let artist = this.artist
    // router params 在部分机型上到不了 protected 字段，歌词本同时写了一份到 storage，
    // 这里兜底读取，避免「点了没反应」。
    if (!key) {
      try {
        key = await store.get('lyric.reader.key')
        if (!title) {
          title = await store.get('lyric.reader.title')
        }
        if (!artist) {
          artist = await store.get('lyric.reader.artist')
        }
      } catch (e) {
        debug.error('page:reader', 'store', e)
      }
      this.key = key
      this.title = title
      this.artist = artist
    }
    if (!key) {
      debug.mark('page:reader', '没有可读的 key')
      this.reason = '没有拿到要打开的歌词，请回到歌词本重新选择'
      this.lines = []
      this.pageLines = []
      return
    }
    if (this.key === '__current__') {
      const lyrics = player.getLyrics()
      text = lyrics.text
      title = lyrics.title
      artist = lyrics.artist
      this.isCurrent = true
    } else {
      text = await library.read(key)
      const header = library.parseHeader(text)
      if (header.title) {
        title = header.title
      }
      if (header.artist) {
        artist = header.artist
      }
      this.isCurrent = (title === view.title && artist === view.artist)
    }
    if (!text) {
      debug.mark('page:reader', '歌词文件为空 ' + key)
      this.reason = '这首歌的歌词文件读不出来，试着让手机重新推一次'
      this.lines = []
      this.pageLines = []
      return
    }
    const parsed = lrc.parse(text, title, artist)
    if (!parsed.lines.length) {
      this.reason = '这首歌的歌词没有时间轴，无法按句显示'
    }
    this.lines = parsed.lines
    this.songTitle = this.shorten(title || parsed.meta.title || '未命名', 11)
    this.songArtist = this.shorten(artist || parsed.meta.artist || '', 14)
    const index = view.lyricIndex
    this.currentIndex = this.isCurrent ? index : -1
    this.rows = this.buildRows()
    this.pageCount = Math.max(1, Math.ceil(this.rows.length / this.pageSize))
    this.page = 0
    if (this.isCurrent && this.follow && index >= 0) {
      const start = this.lineRowStart[index] || 0
      this.page = Math.min(this.pageCount - 1, Math.floor(start / this.pageSize))
    }
    this.buildPage()
  },
  // 每句歌词折成 1-2 个显示行，整本歌词先拍平成行再分页：
  // 行高固定，绝不出现「第二行被裁掉」。
  buildRows() {
    const rows = []
    const starts = []
    for (let i = 0; i < this.lines.length; i++) {
      starts.push(rows.length)
      const parts = lrc.wrap(this.lines[i].text, 10, 1)
      const texts = parts.length ? parts : ['']
      for (let j = 0; j < texts.length; j++) {
        rows.push({
          text: texts[j],
          first: j === 0,
          lineIndex: i,
          time: this.lines[i].time,
          timeText: lrc.formatTime(this.lines[i].time),
          active: this.isCurrent && i === this.currentIndex && j === 0
        })
      }
    }
    this.lineRowStart = starts
    return rows
  },
  shorten(text, max) {
    const value = String(text || '')
    return value.length > max ? value.slice(0, max - 1) + '…' : value
  },
  onPlayer(view) {
    if (!this.isCurrent) {
      return
    }
    const index = view.lyricIndex
    if (index === this.currentIndex) {
      return
    }
    this.currentIndex = index
    this.rows = this.buildRows()
    if (this.follow && index >= 0) {
      const start = this.lineRowStart[index] || 0
      const target = Math.min(this.pageCount - 1, Math.floor(start / this.pageSize))
      if (target !== this.page) {
        this.page = target
      }
    }
    this.buildPage()
  },
  buildPage() {
    const start = this.page * this.pageSize
    const end = Math.min(this.rows.length, start + this.pageSize)
    this.pageLines = this.rows.slice(start, end)
    this.pageInfo = (this.page + 1) + '/' + this.pageCount
  },
  vibrate() {
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
  },
  onLine(item) {
    if (!item) {
      return
    }
    if (!this.isCurrent) {
      prompt.showToast({ message: '仅当前播放歌曲支持跳转', duration: 1500 })
      return
    }
    this.vibrate()
    player.seekTo(item.time).catch(() => {})
    if (!this.follow) {
      this.currentIndex = item.lineIndex
      this.rows = this.buildRows()
      this.buildPage()
    }
  },
  prevPage() {
    if (this.page <= 0) {
      return
    }
    this.vibrate()
    this.page -= 1
    this.buildPage()
  },
  nextPage() {
    if (this.page >= this.pageCount - 1) {
      return
    }
    this.vibrate()
    this.page += 1
    this.buildPage()
  },
  toggleFollow() {
    this.follow = !this.follow
    player.setFollow(this.follow)
    if (this.follow && this.isCurrent && this.currentIndex >= 0) {
      this.page = Math.min(this.pageCount - 1, Math.floor(this.currentIndex / this.pageSize))
      this.buildPage()
    }
  },
  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 6dp;
  padding-right: 10dp;
  padding-bottom: 6dp;
  padding-left: 10dp;
  flex-direction: column;
  background-color: #070b10;
}
.header {
  flex-grow: 0;
  flex-shrink: 0;
  width: 100%;
  height: 20dp;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.back {
  width: 24dp;
  height: 20dp;
  align-items: center;
  justify-content: center;
}
.back-icon {
  width: 15dp;
  height: 15dp;
}
.back-old {
  font-size: 11dp;
  font-weight: bold;
  color: #6ef3c5;
  padding-top: 3dp;
  padding-right: 4dp;
  padding-bottom: 3dp;
  padding-left: 4dp;
}
.header-title {
  font-size: 12dp;
  font-weight: bold;
  color: #9aa9bc;
}
.page-num {
  font-size: 10.5dp;
  font-weight: bold;
  color: #4f6074;
  padding-top: 3dp;
  padding-right: 4dp;
  padding-bottom: 3dp;
  padding-left: 4dp;
}
.song {
  flex-grow: 0;
  flex-shrink: 0;
  width: 100%;
  margin-top: 2dp;
  flex-direction: column;
}
.song-title {
  font-size: 14.5dp;
  font-weight: bold;
  color: #eef4fb;
}
.song-artist {
  margin-top: 0.5dp;
  font-size: 10.5dp;
  font-weight: bold;
  color: #63748a;
}
.content {
  flex: 1;
  width: 100%;
  margin-top: 3dp;
  flex-direction: column;
}
.line-row {
  width: 100%;
  height: 19dp;
  flex-direction: row;
  align-items: center;
}
.time-col {
  width: 31dp;
  height: 19dp;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  margin-right: 4dp;
}
.line-time {
  font-size: 9dp;
  line-height: 19dp;
  font-weight: bold;
  color: #3f4f62;
  text-align: right;
}
.line-text {
  lines: 1;
  flex: 1;
  font-size: 12.5dp;
  line-height: 19dp;
  font-weight: bold;
  color: #8b9aad;
}
.line-text-active {
  color: #6ef3c5;
}
.empty {
  flex: 1;
  width: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.empty-title {
  font-size: 13.5dp;
  font-weight: bold;
  color: #c4cfdd;
}
.empty-desc {
  margin-top: 3dp;
  font-size: 10.5dp;
  font-weight: bold;
  color: #5d6e83;
  text-align: center;
  padding-top: 0;
  padding-right: 10dp;
  padding-bottom: 0;
  padding-left: 10dp;
}
.chip {
  height: 20dp;
  padding-top: 0;
  padding-right: 10dp;
  padding-bottom: 0;
  padding-left: 10dp;
  margin-top: 7dp;
  border-radius: 10dp;
  background-color: #0e151e;
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-style: solid;
  border-color: #1c2836;
}
.chip-text {
  font-size: 11.5dp;
  font-weight: bold;
  color: #b9c6d6;
}
.footer {
  flex-grow: 0;
  flex-shrink: 0;
  width: 100%;
  height: 24dp;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.nav-btn {
  width: 30%;
  height: 22dp;
  border-radius: 9dp;
  align-items: center;
  justify-content: center;
  background-color: #0e151e;
  border-width: 1px;
  border-style: solid;
  border-color: #1c2836;
}
.nav-btn-disabled {
  opacity: 0.4;
}
.nav-text {
  font-size: 11dp;
  font-weight: bold;
  color: #b9c6d6;
}
.follow {
  width: 34%;
  height: 22dp;
  border-radius: 9dp;
  align-items: center;
  justify-content: center;
  background-color: #0b121a;
  border-width: 1px;
  border-style: solid;
  border-color: #1c2836;
}
.follow-on {
  background-color: #0f2a24;
  border-width: 1px;
  border-style: solid;
  border-color: #28a888;
}
.follow-text {
  font-size: 10.5dp;
  font-weight: bold;
  color: #6ef3c5;
}
</style>
