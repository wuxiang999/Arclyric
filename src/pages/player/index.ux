<template>
  <div class="page">
    <div class="topbar">
      <div class="status">
        <div class="dot dot-{{connected ? 'ok' : (mock ? 'demo' : 'off')}}"></div>
        <text class="status-text">{{statusText}}</text>
      </div>
      <div class="tools">
        <div class="tool" @click="openBook">
          <image class="tool-icon" src="/common/images/ic_book.png"></image>
        </div>
        <div class="tool" @click="openSettings">
          <image class="tool-icon" src="/common/images/ic_gear.png"></image>
        </div>
      </div>
    </div>

    <div class="meta">
      <div class="meta-text">
        <text class="title" @click="openLyrics">{{title}}</text>
        <text class="artist" @click="openLyrics">{{artist}}</text>
      </div>
      <div class="add-btn" @click="addToBook">
        <image class="add-icon" src="/common/images/ic_book_add.png"></image>
      </div>
    </div>

    <div class="lyric" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd" @swipe="onSwipe" @click="onLyricTap">
      <block if="{{loading}}">
        <image class="spinner" src="/common/images/spin{{spinFrame}}.png"></image>
        <text class="loading-text">{{loadingText}}</text>
        <block if="{{transferActive}}">
          <div class="loading-track">
            <div class="fill fill-w{{transferLevel}}"></div>
          </div>
          <text class="loading-sub">已收到 {{transferReceived}}/{{transferTotal}} 包</text>
        </block>
      </block>
      <block if="{{!loading}}">
        <!-- 手势与点击只绑在外层 .lyric：行内再绑一次会冒泡成两次，
             滑动后「吞点击」标志被第一次消费，第二次就把页面推走了 -->
        <text class="lyric-row {{$item.cls}}" for="{{rows}}">{{$item.text}}</text>
        <text class="lyric-hint" if="{{hintOn}}">轻触回到当前句</text>
      </block>
    </div>

    <div class="vol-row">
      <div class="vol-btn" @click="volDown">
        <image class="vol-icon" src="/common/images/ic_vol_down.png"></image>
      </div>
      <div class="vol-track">
        <div class="vol-fill vol-w{{volLevel}}"></div>
      </div>
      <div class="vol-btn" @click="volUp">
        <image class="vol-icon" src="/common/images/ic_vol_up.png"></image>
      </div>
      <text class="vol-text">{{volume}}%</text>
    </div>

    <block if="{{showProgress}}">
      <!-- 进度条整条都可拖动：按下即预览，松手才真正 seek，避免拖动时狂发指令 -->
      <div class="progress" @touchstart="onBarStart" @touchmove="onBarMove" @touchend="onBarEnd">
        <div class="track">
          <div class="fill fill-w{{barLevel}}"></div>
        </div>
      </div>
      <div class="times">
        <text class="time">{{positionText}}</text>
        <text class="time">{{durationText}}</text>
      </div>
    </block>

    <div class="controls">
      <div class="ctrl ctrl-side" @click="onPrev">
        <image class="ctrl-icon" src="/common/images/ic_prev.png"></image>
      </div>
      <div class="ctrl ctrl-main" @click="onToggle">
        <image class="ctrl-icon-main" if="{{playing}}" src="/common/images/ic_pause.png"></image>
        <image class="ctrl-icon-main" if="{{!playing}}" src="/common/images/ic_play.png"></image>
      </div>
      <div class="ctrl ctrl-side" @click="onNext">
        <image class="ctrl-icon" src="/common/images/ic_next.png"></image>
      </div>
    </div>

  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import prompt from '@system.prompt'
import player from '../../common/scripts/player-state.js'
import lrc from '../../common/scripts/lrc.js'
import debug from '../../common/scripts/debug.js'

// 每行能放多少「显示单位」：中日韩字算 1，西文算 0.55。
// 单位数不能拍脑袋写死，必须按「可用宽度 / 字号」算出来再留 4% 余量，
// 否则估算偏大 1 个字就会二次折行，把整块歌词顶出容器，看起来就是被吞了一截。
const ON_SIZE = [14.5, 16.5, 18]
const OFF_SIZE = [11, 12.5, 14]
// 屏幕 192 逻辑宽 - 左右各 11 内边距 = 170，再让 2dp 给渲染误差
const LYRIC_WIDTH = 168
const SIZE_KEY = ['s', 'm', 'l']
// 每行实际占高 = line-height + 上下各 1dp 内边距，和 CSS 严格对应
const ON_H = [22, 25, 27]
const OFF_H = [18, 20, 22]
// 歌词区可用高度：删掉 ±10s、加音量行后重算（264 - 固定 155 - 上边距 2 ≈ 107）
// 显示进度条时 104dp（留 3dp 余量），隐藏进度条时多出 36dp
const LYRIC_BUDGET = [104, 140]
const HINT_H = 16

function unitsFor(size) {
  return Math.max(6, Math.floor((LYRIC_WIDTH / size) * 0.96))
}

export default {
  data: {
    title: '未在播放',
    artist: '连接手机后自动同步',
    percent: 0,
    positionText: '0:00',
    durationText: '0:00',
    playing: false,
    connected: false,
    mock: true,
    barLevel: 0,
    volume: 70,
    volLevel: 70,
    statusText: '演示模式',
    rows: [{ text: '等待歌词', cls: 'on-m' }],
    browsing: false,
    hintOn: false,
    fontSize: 1,
    swipeStep: 1,
    vibrateOn: true,
    showProgress: true,
    loading: true,
    loadingText: '正在准备',
    spinFrame: 0,
    transferActive: false,
    transferReceived: 0,
    transferTotal: 0,
    transferLevel: 0
  },
  onInit() {
    debug.mark('page:player', 'onInit')
    this.lines = []
    this.focus = -1
    this.touchX = 0
    this.touchY = 0
    this.touchAt = 0
    this.touchMoved = false
    this.swiped = false
    this.swipedAt = 0
    this.lastBrowseAt = 0
    this.lastOpenAt = 0
    this.lastAddAt = 0
    this.browseIdleMs = 6000
    this.browseTimer = null
    this.loadTimer = null
    this.durationMs = 0
    this.barDrag = false
    this.barMs = -1
    // Vela 没有 CSS 动画，加载动效只能靠定时器换帧；加载结束就停，别常驻
    this.startLoadTimer()
    try {
      this.unsubscribe = player.subscribe((reason, view) => {
        this.apply(view, reason)
      })
      player.init().then(() => {
        this.apply(player.snapshot(), 'ready')
        debug.mark('page:player', '数据已应用')
      }).catch((err) => {
        debug.error('page:player', 'player.init', err)
      })
    } catch (e) {
      debug.error('page:player', 'onInit', e)
    }
  },
  onShow() {
    debug.mark('page:player', 'onShow')
    try {
      this.apply(player.snapshot(), 'show')
    } catch (e) {
      debug.error('page:player', 'onShow', e)
    }
  },
  startLoadTimer() {
    if (this.loadTimer) {
      return
    }
    // Vela 没有 CSS 动画：0-7 帧圆形图片轮换就是转圈加载（约 7 帧/秒，省电）
    this.loadTimer = setInterval(() => {
      this.spinFrame = (this.spinFrame + 1) % 8
    }, 130)
  },
  stopLoadTimer() {
    if (this.loadTimer) {
      clearInterval(this.loadTimer)
      this.loadTimer = null
    }
    this.spinFrame = 0
  },
  onDestroy() {
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
    if (this.browseTimer) {
      clearTimeout(this.browseTimer)
      this.browseTimer = null
    }
    if (this.loadTimer) {
      clearInterval(this.loadTimer)
      this.loadTimer = null
    }
  },
  shorten(text, max) {
    if (!text) {
      return ''
    }
    const value = String(text).trim()
    return value.length > max ? value.slice(0, max - 1) + '…' : value
  },
  apply(view, reason) {
    // 每秒的 tick 只更新进度，不重建歌词行：手环内存小，重建会掉帧
    if (reason === 'tick') {
      this.playing = view.playing
      // 手指按在进度条上时不跟播放进度抢，否则拖动会被每秒的刷新拽回去
      if (this.barDrag) {
        return
      }
      this.percent = view.percent
      this.barLevel = Math.round((Number(view.percent) || 0) / 10) * 10
      this.positionText = view.positionText
      this.durationText = view.durationText
      return
    }
    this.title = this.shorten(view.title || '未在播放', 8)
    this.artist = this.shorten(view.artist || (view.mock ? '演示曲目' : '未知歌手'), 13)
    this.percent = view.percent
    this.barLevel = Math.round((Number(view.percent) || 0) / 10) * 10
    this.positionText = view.positionText
    this.durationText = view.durationText
    this.durationMs = Number(view.duration) || 0
    this.volume = Math.max(0, Math.min(100, Math.round(Number(view.volume) || 0)))
    this.volLevel = Math.round(this.volume / 10) * 10
    this.playing = view.playing
    this.connected = view.connected
    this.mock = view.mock
    this.showProgress = view.showProgress !== false
    const idle = Number(view.browseIdle) || 6
    this.browseIdleMs = Math.max(3, Math.min(10, Math.round(idle))) * 1000

    const lines = view.lines || []
    const receiving = !!view.transferActive && !view.mock
    this.transferActive = receiving
    this.transferReceived = Number(view.transferReceived) || 0
    this.transferTotal = Number(view.transferTotal) || 0
    const pct = Number(view.transferPercent) || 0
    // 进度条只有 10 / 20 … 100 这几档宽度，向下取整避免看起来比实际多
    this.transferLevel = Math.max(0, Math.min(100, Math.floor(pct / 10) * 10))
    // 有词就正常显示；没词时给出「在等什么」的提示和进度条
    if (lines.length) {
      this.loading = false
    } else if (view.mock) {
      this.loading = false
    } else {
      this.loading = true
      // 手机正在发歌词就报真实分包进度，否则报等待状态
      this.loadingText = receiving ? '正在接收歌词' : (view.connected ? '等待手机歌词' : '等待连接手机')
    }
    const songChanged = this.song !== (view.title + '|' + view.artist)
    this.song = view.title + '|' + view.artist
    this.lines = lines
    if (songChanged) {
      this.browsing = false
      this.focus = view.lyricIndex
    }
    // 没有在手动翻歌词时，焦点永远跟着播放进度走
    if (!this.browsing) {
      this.focus = view.lyricIndex
    }
    // 字号必须先更新再重建行，否则切换字号会慢一拍
    this.fontSize = typeof view.fontSize === 'number' ? view.fontSize : 1
    this.swipeStep = Math.max(1, Math.min(3, Number(view.swipeStep) || 1))
    this.vibrateOn = view.vibrate !== false
    this.buildRows()

    if (view.connected) {
      this.statusText = '已连接手机'
    } else if (view.mock) {
      this.statusText = '演示模式'
    } else {
      this.statusText = '等待连接'
    }
    if (this.loading) {
      this.startLoadTimer()
    } else {
      this.stopLoadTimer()
    }
  },
  // 焦点句 + 前后各一句，逐行手工折行。
  // 关键：按「可用高度」决定放几行，绝不靠 flex 压缩 —— 那正是文字被吞一截的原因。
  buildRows() {
    const lines = this.lines || []
    const size = Math.max(0, Math.min(2, this.fontSize || 0))
    const key = SIZE_KEY[size]
    const curUnits = unitsFor(ON_SIZE[size])
    const sideUnits = unitsFor(OFF_SIZE[size])
    const onH = ON_H[size]
    const offH = OFF_H[size]
    const budget = this.showProgress ? LYRIC_BUDGET[0] : LYRIC_BUDGET[1]
    if (!lines.length) {
      this.hintOn = false
      this.rows = [{ text: '暂无歌词', cls: 'on-' + key }]
      return
    }
    const index = Math.max(0, Math.min(lines.length - 1, this.focus))
    const curRows = lrc.wrap(lines[index].text, curUnits, 4)
    if (!curRows.length) {
      curRows.push('')
    }
    let used = curRows.length * onH
    // 浏览态的提示行也参与高度预算，放不下就不显示
    const showHint = this.browsing && used + HINT_H <= budget
    if (showHint) {
      used += HINT_H
    }
    const prevText = index > 0 ? lrc.wrap(lines[index - 1].text, sideUnits, 1)[0] : ''
    const nextText = index < lines.length - 1 ? lrc.wrap(lines[index + 1].text, sideUnits, 1)[0] : ''
    const rows = []
    if (prevText && used + offH <= budget) {
      rows.push({ text: prevText, cls: 'off-' + key })
      used += offH
    }
    for (let i = 0; i < curRows.length; i++) {
      rows.push({ text: curRows[i], cls: 'on-' + key })
    }
    if (nextText && used + offH <= budget) {
      rows.push({ text: nextText, cls: 'off-' + key })
    }
    this.hintOn = showHint
    this.rows = rows
  },
  onTouchStart(evt) {
    const point = this.pointOf(evt, 'start')
    this.touchX = point ? Number(point.clientX) || 0 : 0
    this.touchY = point ? Number(point.clientY) || 0 : 0
    this.touchAt = Date.now()
    this.touchMoved = false
    // 上一次滑动遗留的「吞点击」标志要在新的按下时清掉
    this.swiped = false
  },
  onTouchMove(evt) {
    const point = this.pointOf(evt, 'move')
    if (!point) {
      return
    }
    // 真机上手指离开时可能收不到 move，这里只做提前判定
    if (Math.abs((Number(point.clientY) || 0) - this.touchY) > 10) {
      this.touchMoved = true
    }
  },
  onTouchEnd(evt) {
    const point = this.pointOf(evt, 'end')
    if (!point) {
      return
    }
    const dy = (Number(point.clientY) || 0) - this.touchY
    const dx = (Number(point.clientX) || 0) - this.touchX
    const elapsed = Date.now() - (this.touchAt || 0)
    // 位移太小、横向为主、按太久（长按）都当点击，交给 onLyricTap
    if (Math.abs(dy) < 12 || Math.abs(dy) < Math.abs(dx) || elapsed > 1500) {
      return
    }
    this.markSwiped()
    // 一次滑动固定按设置走，默认 1 句；不再按距离叠加，避免一下跳两段
    const steps = Math.max(1, Math.min(3, this.swipeStep || 1))
    this.browse(dy < 0 ? steps : -steps)
  },
  // 系统手势事件：部分固件上 touchend 拿不到坐标，用 swipe 兜底
  onSwipe(evt) {
    const dir = evt && evt.direction
    if (dir !== 'up' && dir !== 'down') {
      return
    }
    this.markSwiped()
    const steps = Math.max(1, Math.min(3, this.swipeStep || 1))
    this.browse(dir === 'up' ? steps : -steps)
  },
  markSwiped() {
    this.swiped = true
    this.swipedAt = Date.now()
    this.touchMoved = false
  },
  pointOf(evt, phase) {
    if (!evt) {
      return null
    }
    let list = null
    if (phase === 'end') {
      list = evt.changedTouches || evt.touches
    } else if (phase === 'move') {
      list = evt.touches || evt.changedTouches
    } else {
      list = evt.touches || evt.changedTouches
    }
    if (list && list.length) {
      return list[0]
    }
    if (evt.clientY !== undefined) {
      return evt
    }
    return null
  },
  // 上滑往后看、下滑往前看；停手 6 秒自动回到跟随播放
  browse(delta) {
    const lines = this.lines || []
    if (!lines.length) {
      return
    }
    // 同一次滑动可能同时触发 touchend 和 swipe，200ms 内只认一次
    const now = Date.now()
    if (now - this.lastBrowseAt < 200) {
      return
    }
    this.lastBrowseAt = now
    const base = this.focus < 0 ? 0 : this.focus
    const target = Math.max(0, Math.min(lines.length - 1, base + delta))
    if (target === base && !this.browsing) {
      return
    }
    this.focus = target
    this.browsing = true
    this.buildRows()
    this.vibrate()
    if (this.browseTimer) {
      clearTimeout(this.browseTimer)
    }
    this.browseTimer = setTimeout(() => {
      this.browseTimer = null
      this.browsing = false
      this.focus = player.snapshot().lyricIndex
      this.buildRows()
    }, this.browseIdleMs || 6000)
  },
  onLyricTap() {
    // 滑动结束系统还会补一个 click：吞掉它，否则每滑一次都会被带去歌词页
    if (this.swiped) {
      this.swiped = false
      if (Date.now() - this.swipedAt < 500) {
        return
      }
    }
    // 浏览状态下点击 = 跳回当前播放句（顺手 seek 到手动停留的那句没意义）
    if (this.browsing) {
      this.browsing = false
      if (this.browseTimer) {
        clearTimeout(this.browseTimer)
        this.browseTimer = null
      }
      this.focus = player.snapshot().lyricIndex
      this.buildRows()
      return
    }
    this.openLyrics()
  },
  vibrate() {
    if (!this.vibrateOn) {
      return
    }
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {}
  },
  onToggle() {
    this.vibrate()
    player.toggle().catch(() => {})
  },
  onPrev() {
    this.vibrate()
    player.previous().catch(() => {})
  },
  onNext() {
    this.vibrate()
    player.next().catch(() => {})
  },
  volDown() {
    this.vibrate()
    player.volumeStep(-10).catch(() => {})
  },
  volUp() {
    this.vibrate()
    player.volumeStep(10).catch(() => {})
  },
  // 进度条整条可拖：按下先本地预览，松手才发 seek，避免拖动时一路狂发指令
  onBarStart(evt) {
    if (!this.durationMs) {
      return
    }
    this.barDrag = true
    this.barTrack(evt, 'start')
  },
  onBarMove(evt) {
    if (!this.barDrag) {
      return
    }
    this.barTrack(evt, 'move')
  },
  onBarEnd(evt) {
    if (!this.barDrag) {
      return
    }
    this.barTrack(evt, 'end')
    this.barDrag = false
    const ms = this.barMs
    if (ms >= 0 && this.durationMs > 0) {
      this.vibrate()
      player.seekTo(ms).catch(() => {})
    }
    this.barMs = -1
  },
  barTrack(evt, phase) {
    const point = this.pointOf(evt, phase)
    if (!point) {
      return
    }
    const x = Number(point.clientX) || 0
    // 页面左右各 11dp 内边距，进度条宽 170dp
    const ratio = Math.max(0, Math.min(1, (x - 11) / 170))
    const ms = Math.round(ratio * (this.durationMs || 0))
    this.barMs = ms
    this.percent = Math.round(ratio * 100)
    this.barLevel = Math.round(this.percent / 10) * 10
    this.positionText = lrc.formatTime(ms)
  },
  // 手动「加入歌词本」：默认不再每首歌自动入库，想存哪首点这里
  addToBook() {
    this.vibrate()
    this.lastAddAt = Date.now()
    const view = player.snapshot()
    if (!view.hasLyrics) {
      try {
        prompt.showToast({ message: '还没有歌词，已请求手机推送', duration: 1500 })
      } catch (e) {}
      player.requestLyrics().catch(() => {})
      return
    }
    player.saveCurrentLyrics().then(function (key) {
      try {
        prompt.showToast({ message: key ? '已加入歌词本' : '加入失败', duration: 1200 })
      } catch (e) {}
    }).catch(function () {
      try {
        prompt.showToast({ message: '加入失败', duration: 1200 })
      } catch (e) {}
    })
  },
  openLyrics() {
    // 外层容器和歌词行都可能触发 click，600ms 内只跳一次，避免压两层歌词页
    const now = Date.now()
    if (now - (this.lastOpenAt || 0) < 600) {
      return
    }
    // 点「加入歌词本」时事件若冒泡上来，不能顺手把页面推走
    if (now - (this.lastAddAt || 0) < 500) {
      return
    }
    this.lastOpenAt = now
    router.push({ uri: '/pages/lyrics' })
  },
  openBook() {
    router.push({ uri: '/pages/book' })
  },
  openSettings() {
    router.push({ uri: '/pages/settings' })
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 6dp;
  padding-right: 11dp;
  padding-bottom: 4dp;
  padding-left: 11dp;
  flex-direction: column;
  background-color: #070b10;
}
.topbar {
  flex-grow: 0;
  flex-shrink: 0;
  width: 100%;
  height: 16dp;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.status {
  flex-direction: row;
  align-items: center;
}
.dot {
  width: 5dp;
  height: 5dp;
  border-radius: 3dp;
  margin-right: 4dp;
  background-color: #63748a;
}
.dot-ok {
  background-color: #6ef3c5;
}
.dot-demo {
  background-color: #ffc46b;
}
.dot-off {
  background-color: #ff7a7a;
}
.status-text {
  font-size: 11dp;
  font-weight: bold;
  color: #9aa9bc;
}
.tools {
  flex-direction: row;
  align-items: center;
}
.tool {
  width: 22dp;
  height: 18dp;
  margin-left: 5dp;
  align-items: center;
  justify-content: center;
}
.tool-icon {
  width: 15dp;
  height: 15dp;
}
.meta {
  flex-grow: 0;
  flex-shrink: 0;
  width: 100%;
  height: 34dp;
