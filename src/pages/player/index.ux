  font-size: 10.5dp;
  font-weight: bold;
  color: #4f6074;
}
.controls {
  flex-grow: 0;
  flex-shrink: 0;
  width: 100%;
  margin-top: 4dp;
  height: 42dp;
  flex-direction: row;
  align-items: center;
}
.ctrl {
  height: 42dp;
  border-radius: 21dp;
  align-items: center;
  justify-content: center;
  background-color: #0e151e;
  border-width: 1px;
  border-style: solid;
  border-color: #1c2836;
}
.ctrl-side {
  width: 25%;
}
.ctrl-main {
  width: 46%;
  margin-left: 2%;
  margin-right: 2%;
  background-color: #6ef3c5;
  border-width: 1px;
  border-style: solid;
  border-color: #6ef3c5;
}
.ctrl-icon {
  width: 21dp;
  height: 21dp;
}
.ctrl-icon-main {
  width: 26dp;
  height: 26dp;
}
