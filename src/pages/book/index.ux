<template>
  <div class="page">
    <div class="header">
      <div class="back" @click="goBack">
        <image class="back-icon" src="/common/images/ic_back.png"></image>
      </div>
      <text class="header-title">歌词本</text>
      <text class="manage" if="{{!detail}}" @click="toggleManage">{{manage ? '完成' : '管理'}}</text>
      <text class="manage" if="{{detail}}" @click="closeDetail">返回列表</text>
    </div>

    <!-- 列表：固定 6 行窗口 + 上下滑动，不再翻页 -->
    <div class="body" if="{{!detail}}">
      <block if="{{loading}}">
        <div class="loading-box">
          <image class="spinner" src="/common/images/spin{{spinFrame}}.png"></image>
          <text class="loading-text">{{loadingText}}</text>
        </div>
      </block>
      <block if="{{!loading}}">
        <div class="info">
          <text class="info-text">共 {{total}} 首</text>
          <text class="info-hint" if="{{manage}}">再点一次删除</text>
          <text class="info-page" if="{{!manage}}">{{rangeText}}</text>
        </div>

        <div class="window" if="{{total > 0}}" @touchstart="onListStart" @touchmove="onListMove" @touchend="onListEnd">
          <div class="row" for="{{items}}" @click="onItem($item)">
            <div class="row-main">
              <text class="row-title">{{$item.displayTitle}}</text>
              <text class="row-sub">{{$item.displayArtist}}</text>
            </div>
            <text class="row-arrow" if="{{!manage}}">›</text>
            <text class="row-action {{$item.confirm ? 'row-action-danger' : ''}}" if="{{manage}}">{{$item.confirm ? '确认' : '删除'}}</text>
          </div>
        </div>

        <div class="empty" if="{{total === 0}}">
          <text class="empty-icon">≡</text>
          <text class="empty-title">词本还是空的</text>
          <text class="empty-desc">播放页点「加入歌词本」即可收藏</text>
          <div class="chip" @click="loadDemo">
            <text class="chip-text">载入示例歌词</text>
          </div>
        </div>
      </block>
    </div>

    <!-- 阅读：窗口式上下滑动，跟随当前播放句自动滚动 -->
    <div class="body" if="{{detail}}">
      <block if="{{loading}}">
        <div class="loading-box">
          <image class="spinner" src="/common/images/spin{{spinFrame}}.png"></image>
          <text class="loading-text">{{loadingText}}</text>
        </div>
      </block>
      <block if="{{!loading}}">
        <div class="info">
          <text class="info-text">{{dTitle}}</text>
          <text class="follow-chip {{dFollow ? 'follow-on' : ''}}" @click="backToCurrent">{{dFollow ? '跟随中' : '回到当前'}}</text>
        </div>

        <div class="window read" @touchstart="onReadStart" @touchmove="onReadMove" @touchend="onReadEnd">
          <text class="line {{$item.cls}}" for="{{dView}}">{{$item.text}}</text>
        </div>

        <div class="read-foot">
          <text class="foot-text">{{dStatus}}</text>
        </div>
      </block>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import library from '../../common/scripts/library.js'
import lrc from '../../common/scripts/lrc.js'
import demo from '../../common/scripts/demo-lyrics.js'
import player from '../../common/scripts/player-state.js'
import debug from '../../common/scripts/debug.js'

// 列表固定 6 行窗口：行高 34dp，只渲染看得见的这几行，词本几百首也不卡
const LIST_ROWS = 6
const ROW_H = 34
// 手指划到 0.8 行就滚一行：跟手滑，不用等抬手才跳
const LIST_DRAG = ROW_H * 0.8
// 阅读窗口 10 行：行高 20dp
const READ_ROWS = 10
const READ_H = 19
const READ_DRAG = READ_H * 0.8
// 172dp 可用宽 / 13dp 字号 ≈ 13 个字，留 4% 余量防二次折行
const READ_UNITS = 12
// 空行占位：窗口里行数恒定，滚动时框架只改文字，不重建节点树
function emptyRow() {
  return {
    key: '',
    title: '',
    artist: '',
    displayTitle: '',
    displayArtist: '',
    confirm: false
  }
}

export default {
  data: {
    all: [],
    items: [],
    total: 0,
    listRows: LIST_ROWS,
    listStart: 0,
    rangeText: '',
    manage: false,
    confirmKey: '',
    detail: false,
    dTitle: '',
    dArtist: '',
    dSongTitle: '',
    dRows: [],
    dView: [],
    dStart: 0,
    dFollow: true,
    dCur: -1,
    dStatus: '',
    loading: true,
    loadingText: '正在读取词库',
    spinFrame: 0
  },
  onInit() {
    debug.mark('page:book', 'onInit')
    this.loadTimer = null
    this.busy = false
    this.swiped = false
    this.swipedAt = 0
    this.touchY = 0
    this.dLineFirst = []
    this.startLoadTimer()
    this.load()
    // 歌词本跟着播放进度自己滚：只在阅读页且「跟随」时动，tick 不处理省性能
    try {
      this.unsubscribe = player.subscribe((reason, view) => {
        if (reason === 'tick' || !this.detail || !this.dFollow) {
          return
        }
        this.follow(view)
      })
      // 这个页面之前没初始化过播放状态，跟随根本没数据可用
      player.init().then(() => {
        if (this.detail && this.dFollow) {
          this.follow(player.snapshot())
        }
      }).catch((err) => {
        debug.error('page:book', 'player.init', err)
      })
    } catch (e) {
      debug.error('page:book', 'subscribe', e)
    }
  },
  onDestroy() {
    this.stopLoadTimer()
    if (this.unsubscribe) {
      this.unsubscribe()
      this.unsubscribe = null
    }
  },
  onShow() {
    try {
      player.reattach()
      player.requestResync()
    } catch (e) {}
    if (!this.detail) {
      this.load()
    } else if (this.dFollow) {
      this.follow(player.snapshot())
    }
  },
  startLoadTimer() {
    if (this.loadTimer) {
      return
    }
    // Vela 没有 CSS 动画，圆形加载是 8 帧图片轮换
    this.loadTimer = setInterval(() => {
      this.spinFrame = (this.spinFrame + 1) % 8
    }, 130)
  },
  stopLoadTimer() {
    if (this.loadTimer) {
      clearInterval(this.loadTimer)
      this.loadTimer = null
    }
    this.spinFrame = 0
  },
  async load() {
    if (!this.total) {
      this.loadingText = '正在读取词库'
      this.loading = true
      this.startLoadTimer()
    }
    try {
      const list = await library.list()
      this.all = list
      this.total = list.length
      this.refreshList()
      debug.mark('page:book', '载入 ' + list.length + ' 首')
    } catch (e) {
      debug.error('page:book', 'load', e)
    }
    this.loading = false
    this.stopLoadTimer()
  },
  refreshList() {
    const maxStart = Math.max(0, this.total - LIST_ROWS)
    this.listStart = Math.max(0, Math.min(this.listStart, maxStart))
    const slice = this.all.slice(this.listStart, this.listStart + LIST_ROWS)
    // 补满固定行数：滚动到词本末尾时节点数不变，不会整块重建
    const view = []
    for (let i = 0; i < LIST_ROWS; i++) {
      const item = slice[i]
      if (!item) {
        view.push(emptyRow())
        continue
      }
      view.push({
        key: item.key,
        title: item.title,
        artist: item.artist,
        displayTitle: this.shorten(item.title, 9),
        displayArtist: item.artist ? this.shorten(item.artist, 12) : '未知歌手',
        confirm: this.manage && this.confirmKey === item.key
      })
    }
    this.items = view
    this.rangeText = this.total
      ? (this.listStart + 1) + '-' + (this.listStart + slice.length) + '/' + this.total
      : '0/0'
  },
  shorten(text, max) {
    const value = String(text || '')
    return value.length > max ? value.slice(0, max - 1) + '…' : value
  },
  pointOf(evt, phase) {
    if (!evt) {
      return null
    }
    const list = phase === 'end'
      ? (evt.changedTouches || evt.touches)
      : (evt.touches || evt.changedTouches)
    if (list && list.length) {
      return list[0]
    }
    if (evt.clientY !== undefined) {
      return evt
    }
    return null
  },
  markSwiped() {
    this.swiped = true
    this.swipedAt = Date.now()
  },
  // ---------- 列表滑动（跟手）----------
  onListStart(evt) {
    const p = this.pointOf(evt, 'start')
    this.touchY = p ? Number(p.clientY) || 0 : 0
    this.lastMoveY = this.touchY
    this.listAcc = 0
    this.listMoved = 0
    this.swiped = false
  },
  onListMove(evt) {
    const p = this.pointOf(evt, 'move')
    if (!p) {
      return
    }
    const y = Number(p.clientY) || 0
    const dy = y - this.lastMoveY
    this.lastMoveY = y
    if (!dy) {
      return
    }
    // 手指每划过 0.8 行就滚一行，列表跟着手指走，而不是抬手才跳一大段
    this.listAcc += dy
    let step = 0
    while (this.listAcc <= -LIST_DRAG) {
      this.listAcc += LIST_DRAG
      step++
    }
    while (this.listAcc >= LIST_DRAG) {
      this.listAcc -= LIST_DRAG
      step--
    }
    if (!step) {
      return
    }
    this.markSwiped()
    this.listMoved += Math.abs(step)
    this.scrollList(step)
  },
  onListEnd() {
    // 抬手时把剩下的一点位移补成一行，相当于一点点惯性
    const acc = this.listAcc
    this.listAcc = 0
    if (Math.abs(acc) >= LIST_DRAG * 0.6) {
      this.scrollList(acc < 0 ? 1 : -1)
      this.listMoved += 1
    }
    if (this.listMoved) {
      this.markSwiped()
    }
  },
  scrollList(delta) {
    if (!delta) {
      return
    }
    const maxStart = Math.max(0, this.total - LIST_ROWS)
    const next = Math.max(0, Math.min(maxStart, this.listStart + delta))
    if (next === this.listStart) {
      return
    }
    this.listStart = next
    this.refreshList()
  },
  toggleManage() {
    this.manage = !this.manage
    this.confirmKey = ''
    this.refreshList()
  },
  async onItem(item) {
    // 空行占位没有 key，点了不算点
    if (!item || !item.key || this.busy) {
      return
    }
    // 滑动结束时系统补发的 click 不算点击，否则一滑就打开一首
    if (this.swiped) {
      this.swiped = false
      if (Date.now() - this.swipedAt < 500) {
        return
      }
    }
    if (this.manage) {
      if (this.confirmKey !== item.key) {
        this.confirmKey = item.key
        this.refreshList()
        return
      }
      this.busy = true
      await library.remove(item.key)
      this.confirmKey = ''
      this.busy = false
      await this.load()
      return
    }
    await this.openDetail(item)
  },
  // 直接在本页展开，不依赖路由参数，点开一定能看到内容
  async openDetail(item) {
    if (this.busy) {
      return
    }
    this.busy = true
    this.loadingText = '正在打开歌词'
    this.loading = true
    this.startLoadTimer()
    this.detail = true
    this.dTitle = this.shorten((item.title || '未命名') + (item.artist ? ' · ' + item.artist : ''), 12)
    this.dArtist = item.artist || ''
    this.dSongTitle = item.title || ''
    this.dRows = []
    this.dView = []
    this.dLineFirst = []
    this.dCur = -1
    let rows = []
    try {
      const text = await library.read(item.key)
      debug.mark('page:book', '打开 ' + item.title + ' ' + text.length + ' 字')
      if (text) {
        const parsed = lrc.parse(text, item.title, item.artist)
        rows = this.buildReadRows(parsed.lines)
      }
      if (!rows.length) {
        rows = [{ text: '这首歌的歌词读不出来，让手机重新推一次试试', line: -1 }]
      }
    } catch (e) {
      debug.error('page:book', 'openDetail', e)
      rows = [{ text: '打开失败，请返回列表重试', line: -1 }]
    }
    this.dRows = rows
    // 打开的就是正在播放的这首：直接跟随，并按当前句居中
    const snap = player.snapshot()
    const same = this.sameSong(snap.title, item.title) && snap.lyricIndex >= 0
    this.dFollow = same
    this.dCur = same ? snap.lyricIndex : -1
    this.dStart = same ? Math.max(0, (this.dLineFirst[snap.lyricIndex] || 0) - 4) : 0
    this.sliceRead()
    this.updateStatus()
    this.loading = false
    this.stopLoadTimer()
    this.busy = false
  },
  buildReadRows(lines) {
    const rows = []
    const first = []
    for (let i = 0; i < lines.length; i++) {
      first.push(rows.length)
      // 一句最多折两行，长句在歌词本里也能完整读到，不用省略号砍掉
      const parts = lrc.wrap(lines[i].text, READ_UNITS, 2)
      const list = parts.length ? parts : ['']
      for (let j = 0; j < list.length; j++) {
        rows.push({ text: list[j], line: i })
      }
    }
    this.dLineFirst = first
    return rows
  },
  sliceRead() {
    const total = this.dRows.length
    const maxStart = Math.max(0, total - READ_ROWS)
    this.dStart = Math.max(0, Math.min(this.dStart, maxStart))
    const view = []
    // 固定 10 行：末尾不足补空行，节点数恒定，滚动时只改文字
    for (let i = 0; i < READ_ROWS; i++) {
      const row = this.dRows[this.dStart + i]
      if (!row) {
        view.push({ text: '', cls: 'line-off' })
        continue
      }
      view.push({
        text: row.text,
        cls: row.line >= 0 && row.line === this.dCur ? 'line-on' : 'line-off'
      })
    }
    this.dView = view
  },
  sameSong(a, b) {
    const norm = (text) => String(text || '')
      .toLowerCase()
      .replace(/[\s\-_—·・.,，。'"'']/g, '')
    const left = norm(a)
    const right = norm(b)
    if (!left || !right) {
      return false
    }
    return left === right || left.indexOf(right) >= 0 || right.indexOf(left) >= 0
  },
  // 按当前播放句把窗口滚到中间：每句只重建 10 行，开销很小
  follow(view) {
    if (!view || !this.dRows.length) {
      return
    }
    const idx = view.lyricIndex
    if (idx < 0) {
      return
    }
    const row = this.dLineFirst[idx]
    if (row === undefined) {
      return
    }
    const start = Math.max(0, row - 4)
    const changed = idx !== this.dCur || start !== this.dStart
    this.dCur = idx
    this.dStart = start
    if (changed) {
      this.sliceRead()
      this.updateStatus()
    }
  },
  updateStatus() {
    const lines = this.dLineFirst.length
    if (!lines) {
      this.dStatus = ''
      return
    }
    const current = this.dCur >= 0 ? (this.dCur + 1) + '/' + lines + ' 句' : '共 ' + lines + ' 句'
    this.dStatus = this.dFollow ? '跟随播放 · ' + current : '手动浏览 · ' + current
  },
  backToCurrent() {
    const snap = player.snapshot()
    const same = this.sameSong(snap.title, this.dSongTitle)
    if (!same) {
      this.dFollow = false
      this.updateStatus()
      return
    }
    this.dFollow = true
    this.follow(snap)
    this.updateStatus()
  },
  // ---------- 阅读滑动（跟手）----------
  onReadStart(evt) {
    const p = this.pointOf(evt, 'start')
    this.touchY = p ? Number(p.clientY) || 0 : 0
    this.lastMoveY = this.touchY
    this.readAcc = 0
    this.readMoved = 0
    this.swiped = false
  },
  onReadMove(evt) {
    const p = this.pointOf(evt, 'move')
    if (!p) {
      return
    }
    const y = Number(p.clientY) || 0
    const dy = y - this.lastMoveY
    this.lastMoveY = y
    if (!dy) {
      return
    }
    this.readAcc += dy
    let step = 0
    while (this.readAcc <= -READ_DRAG) {
      this.readAcc += READ_DRAG
      step++
    }
    while (this.readAcc >= READ_DRAG) {
      this.readAcc -= READ_DRAG
      step--
    }
    if (!step) {
      return
    }
    this.markSwiped()
    this.readMoved += Math.abs(step)
    this.scrollRead(step)
  },
  onReadEnd() {
    const acc = this.readAcc
    this.readAcc = 0
    if (Math.abs(acc) >= READ_DRAG * 0.6) {
      this.scrollRead(acc < 0 ? 1 : -1)
      this.readMoved += 1
    }
    if (this.readMoved) {
      this.markSwiped()
    }
  },
  scrollRead(delta) {
    if (!delta) {
      return
    }
    const maxStart = Math.max(0, this.dRows.length - READ_ROWS)
    const next = Math.max(0, Math.min(maxStart, this.dStart + delta))
    if (next === this.dStart) {
      return
    }
    // 手动滑动 = 暂不跟随，避免刚滑走就被播放进度拽回去
    this.dFollow = false
    this.dStart = next
    this.sliceRead()
    this.updateStatus()
  },
  closeDetail() {
    this.detail = false
    this.manage = false
    this.confirmKey = ''
  },
  async loadDemo() {
    await library.seed(demo.demos)
    await this.load()
  },
  goBack() {
    if (this.detail) {
      this.detail = false
      return
    }
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  padding-top: 6dp;
  padding-right: 10dp;
  padding-bottom: 6dp;
  padding-left: 10dp;
  flex-direction: column;
  background-color: #070b10;
}
.header {
  width: 100%;
  height: 20dp;
  flex-grow: 0;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.back {
  width: 24dp;
  height: 20dp;
  align-items: center;
  justify-content: center;
}
.back-icon {
  width: 15dp;
  height: 15dp;
}
.manage {
  font-size: 11dp;
  line-height: 20dp;
  font-weight: bold;
  color: #6ef3c5;
  padding-left: 4dp;
  padding-right: 4dp;
}
.header-title {
  font-size: 12dp;
  line-height: 20dp;
  font-weight: bold;
  color: #9aa9bc;
}
.body {
  width: 100%;
  flex: 1;
  flex-direction: column;
}
.info {
  width: 100%;
  height: 16dp;
  flex-grow: 0;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.info-text {
  flex: 1;
  lines: 1;
  font-size: 10dp;
  line-height: 16dp;
  font-weight: bold;
  color: #4f6074;
}
.info-hint {
  font-size: 10dp;
  line-height: 16dp;
  font-weight: bold;
  color: #ff7a7a;
}
.info-page {
  font-size: 10dp;
  line-height: 16dp;
  font-weight: bold;
  color: #4f6074;
}
.follow-chip {
  padding-left: 6dp;
  padding-right: 6dp;
  border-radius: 8dp;
  font-size: 9.5dp;
  line-height: 16dp;
  font-weight: bold;
  color: #8fa0b5;
  background-color: #121b26;
  text-align: center;
}
.follow-on {
  color: #6ef3c5;
  background-color: #123b31;
}
/* 固定高度的窗口：只放得下 LIST_ROWS 行，多出来的靠滑动换窗口，不整列表渲染。
   行高合计必须正好等于窗口高度：带 1px 下边框时 6 行会多出 6px，
   最后一首永远被切掉一截，所以这里不用边框。 */
.window {
  width: 100%;
  height: 204dp;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 2dp;
  flex-direction: column;
}
.row {
  width: 100%;
  height: 34dp;
  flex-grow: 0;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}
.dot {
  width: 5dp;
  height: 5dp;
  border-radius: 3dp;
  background-color: #1f3b4c;
  margin-right: 6dp;
}
.row-arrow {
  font-size: 14dp;
  line-height: 20dp;
  font-weight: bold;
  color: #33414f;
  padding-left: 4dp;
}
.row-main {
  flex: 1;
  flex-direction: column;
}
.row-title {
  lines: 1;
  font-size: 13dp;
  line-height: 17dp;
  font-weight: bold;
  color: #eef4fb;
}
.row-sub {
  lines: 1;
  font-size: 10dp;
  line-height: 14dp;
  font-weight: bold;
  color: #63748a;
}
.row-action {
  lines: 1;
  font-size: 11.5dp;
  line-height: 20dp;
  font-weight: bold;
  color: #4f6074;
  padding-left: 4dp;
}
.row-action-danger {
  color: #ff7a7a;
}
.read {
  height: 190dp;
  margin-top: 2dp;
}
.line {
  lines: 1;
  width: 100%;
  font-size: 13dp;
  line-height: 19dp;
  font-weight: bold;
  color: #b9c6d6;
  text-align: left;
}
.line-on {
  color: #6ef3c5;
}
.line-off {
  color: #8b9bad;
}
.read-foot {
  width: 100%;
  height: 16dp;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 2dp;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.foot-text {
  font-size: 9.5dp;
