  background-color: #6ef3c5;
}
.dot-demo {
  background-color: #ffc46b;
}
.dot-off {
  background-color: #ff7a7a;
}
.status-text {
  font-size: 11.5dp;
  line-height: 24dp;
  font-weight: bold;
  color: #9aa9bc;
}
.btn {
  width: 100%;
  height: 28dp;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 4dp;
  border-radius: 9dp;
  background-color: #0e151e;
  border-width: 1px;
  border-color: #1c2836;
  align-items: center;
  justify-content: center;
}
.btn-text {
  font-size: 11.5dp;
  line-height: 24dp;
  font-weight: bold;
  color: #b9c6d6;
}
.opt {
  width: 100%;
  height: 30dp;
  flex-grow: 0;
  flex-shrink: 0;
  margin-bottom: 5dp;
  border-radius: 10dp;
  background-color: #0e151e;
  border-width: 1px;
  border-color: #1c2836;
  align-items: center;
  justify-content: center;
}
.opt-text {
  font-size: 12dp;
  line-height: 26dp;
