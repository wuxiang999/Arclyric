}
.opt-danger {
  background-color: #1b1114;
  border-color: #3a1f24;
}
.opt-text-danger {
  color: #ff8a8a;
}
.opt-label {
  width: 100%;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 2dp;
  font-size: 10dp;
  line-height: 16dp;
  font-weight: bold;
  color: #7b8b9f;
}
.offset-bar {
  width: 100%;
  height: 28dp;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 4dp;
  flex-direction: row;
  align-items: center;
  border-radius: 9dp;
  background-color: #0e151e;
  border-width: 1px;
  border-color: #1c2836;
}
.obtn {
  width: 56dp;
  height: 28dp;
  align-items: center;
  justify-content: center;
}
.osym {
  font-size: 15dp;
  line-height: 26dp;
  font-weight: bold;
  color: #9aa9bc;
}
.oval {
  flex: 1;
  height: 28dp;
  align-items: center;
  justify-content: center;
  border-left-width: 1px;
  border-left-color: #1c2836;
  border-right-width: 1px;
  border-right-color: #1c2836;
}
.oval-text {
  font-size: 11dp;
  line-height: 26dp;
  font-weight: bold;
