  background-color: #123b31;
  border-color: #6ef3c5;
}
.tab-text {
  font-size: 11dp;
  line-height: 24dp;
  font-weight: bold;
  color: #7b8b9f;
  text-align: center;
}
.tab-text-on {
  color: #6ef3c5;
}
.body {
  width: 100%;
  flex: 1;
  flex-direction: column;
  margin-top: 5dp;
}
.card {
  width: 100%;
  height: 96dp;
  flex-grow: 0;
  flex-shrink: 0;
  padding-top: 6dp;
  padding-left: 8dp;
  padding-right: 8dp;
  border-radius: 10dp;
  background-color: #0b121a;
  border-width: 1px;
  border-color: #151f2b;
  flex-direction: column;
}
.status-row {
  width: 100%;
  height: 24dp;
  flex-grow: 0;
  flex-shrink: 0;
  flex-direction: row;
  align-items: center;
}
.dot {
  width: 6dp;
  height: 6dp;
  border-radius: 3dp;
  margin-right: 5dp;
  background-color: #63748a;
}
